# Copier vers .env en local si besoin (ne jamais committer .env)
# Sur Render : lier la base au Web Service — DATABASE_URL est injecté automatiquement.

DEBUG=False
SECRET_KEY=changez-moi-en-production
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# URL Postgres (Internal sur Render, External depuis votre PC)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
