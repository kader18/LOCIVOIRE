# Copier vers .env en local si besoin (ne jamais committer .env)
# Sur Render : lier la base au Web Service — DATABASE_URL est injecté automatiquement.
# Sinon coller l'URL Internal (pas External) dans Environment.

DEBUG=False
SECRET_KEY=changez-moi-en-production
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Internal (Web Service Render ↔ Postgres) :
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a/DBNAME
# External (ton PC uniquement) :
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/DBNAME
