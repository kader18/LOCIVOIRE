{
  "appId": "ci.locivoire.app",
  "appName": "Locivoire",
  "webDir": "www",
  "server": {
    "url": "http://10.0.2.2:8000",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "http://10.0.2.2:*",
      "http://127.0.0.1:*",
      "http://localhost:*",
      "https://*.locivoire.ci",
      "https://locivoire.ci"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2200,
      "launchAutoHide": true,
      "backgroundColor": "#101A30",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#101A30"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#101A30"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#101A30",
    "allowsLinkPreview": false
  }
}
